[Unit]
Description=CrowdGPT orchestrator SQLite backup
After=crowdgpt-orchestrator.service
Requires=crowdgpt-orchestrator.service

[Service]
Type=oneshot
User=crowdgpt
Group=crowdgpt
ExecStart=/opt/crowdgpt/.venv/bin/python /opt/crowdgpt/tools/orchestrator_cli.py backup --dir /var/lib/crowdgpt --backup /var/backups/crowdgpt
StateDirectory=crowdgpt-backup
ReadWritePaths=/var/lib/crowdgpt /var/backups/crowdgpt
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
