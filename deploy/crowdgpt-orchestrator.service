[Unit]
Description=CrowdGPT orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=crowdgpt
Group=crowdgpt
WorkingDirectory=/opt/crowdgpt
EnvironmentFile=/etc/crowdgpt/orchestrator.env
ExecStart=/opt/crowdgpt/.venv/bin/python /opt/crowdgpt/server.py
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/crowdgpt
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
